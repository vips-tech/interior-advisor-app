<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'Upload quotations — Interior Decision Advisor' }) %></head>
<body>
<%- include('partials/topbar') %>
<main>
  <div class="wrap page-shell">
    <aside class="sidebar-panel">
      <div class="sidebar-header">Flow</div>
      <nav class="side-menu">
        <a href="/">Home</a>
        <a href="/start">Choose service</a>
        <a href="/case/<%= c.id %>/pay">Payment</a>
        <a href="/case/<%= c.id %>/intake">Home details</a>
        <a class="active" href="/case/<%= c.id %>/upload">Upload quotes</a>
      </nav>

      <div class="sidebar-contact">
        <div class="sidebar-header">Need help?</div>
        <p><strong>Phone:</strong> +91 98765 43210</p>
        <p><strong>Email:</strong> hello@interiordecisionadvisor.in</p>
        <p><strong>WhatsApp:</strong> +91 98765 43210</p>
      </div>
    </aside>

    <div class="content-panel" style="max-width:640px">
      <div class="steps">
        <span class="step">1. Choose service</span>
        <span class="step">2. Pay</span>
        <span class="step">3. Tell us about your home</span>
        <span class="step active">4. Upload quotes</span>
        <span class="step">5. Submit</span>
      </div>
      <h1 style="font-size:1.4rem;color:var(--brand)">Upload your quotations</h1>
      <p class="muted small">Add each company's quotation as a separate file (PDF, image, or Word document). You can keep adding more quotes until you reach the comparison limit.
        Supporting documents such as floor plan, photo, previous communication or reference design are kept for reference and are not used in the comparison.</p>

      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <% if (locked) { %><div class="notice">This case has already been submitted and is now read-only. Contact us if you need to change something.</div><% } %>

      <% if (!locked) { %>
      <form class="stack" method="post" action="/case/<%= c.id %>/upload" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row-2">
          <div>
            <label>Document type</label>
            <select name="doc_type" id="doc_type" onchange="document.getElementById('subtype-row').hidden = (this.value !== 'SUPPORTING'); document.getElementById('company-row').hidden = (this.value === 'SUPPORTING');">
              <option value="QUOTATION">Quotation (up to 6 per case)</option>
              <option value="SUPPORTING">Supporting document</option>
            </select>
          </div>
          <div>
            <label>Quotation file</label>
            <input type="file" name="quote_file" required accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx">
          </div>
        </div>
        <div class="row-2" id="company-row">
          <div>
            <label>Company name</label>
            <input type="text" name="company_name" placeholder="e.g. Livspace, Homelane, local vendor name">
          </div>
        </div>
        <div class="row-2" id="subtype-row" hidden>
          <div>
            <label>Supporting document type</label>
            <select name="doc_subtype">
              <option>Floor plan</option>
              <option>Photo</option>
              <option>Previous communication</option>
              <option>Reference design</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <button class="btn outline" type="submit">Add this document</button>
      </form>
      <% } %>

      <div class="section">
        <h2 style="font-size:1.05rem">Uploaded so far (<%= quotes.length %>)</h2>
        <% if (quotes.length === 0) { %>
          <p class="muted small">No documents uploaded yet.</p>
        <% } else { %>
          <ul class="list-plain">
            <% quotes.forEach(q => { %>
              <li class="file-row">
                <span>
                  <% if ((q.doc_type || 'QUOTATION') === 'SUPPORTING') { %>
                    <span class="muted small">[Supporting<%= q.doc_subtype ? ': ' + q.doc_subtype : '' %>]</span>
                  <% } else { %>
                    <strong><%= q.company_name %></strong>
                  <% } %>
                  — <span class="muted small"><%= q.original_filename %></span>
                </span>
                <% if (!locked) { %>
                <form method="post" action="/case/<%= c.id %>/upload/<%= q.id %>/delete" onsubmit="return confirm('Remove this document?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn small danger" type="submit">Remove</button>
                </form>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>

      <div class="section" id="quote-comparison">
        <h2 style="font-size:1.05rem">Compare your quotes</h2>
        <p class="muted small">Enter the details from each quotation side by side. These are your notes for comparison, not an independent assessment by our advisor.</p>
        <% if (comparisonSaved) { %>
          <div class="notice">Your comparison is saved with this case and will be available to your advisor.</div>
        <% } %>
        <% if (quotationQuotes.length === 0) { %>
          <div class="notice">Upload quotation files to start your comparison. Supporting documents are not included.</div>
        <% } else { %>
          <% const savedComparisonValues = Object.fromEntries(customerComparisons.map(row => [row.attribute, JSON.parse(row.quote_values || '{}')])); %>
          <% if (quotationQuotes.length < 2) { %>
            <p class="muted small">Upload at least one more quotation to compare companies side by side.</p>
          <% } %>
          <form class="stack" method="post" action="/case/<%= c.id %>/compare">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="comparison-table-wrap customer-comparison-wrap">
              <table class="comparison-table customer-comparison-table">
                <thead>
                  <tr>
                    <th class="sticky-col">Cost and scope</th>
                    <% quotationQuotes.forEach(q => { %>
                      <th>
                        <strong><%= q.company_name || 'Unnamed company' %></strong>
                        <span class="muted small"><%= q.original_filename %></span>
                      </th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% comparisonFields.forEach(field => { const values = savedComparisonValues[field.label] || {}; %>
                    <tr>
                      <th class="sticky-col attribute-cell"><%= field.label %></th>
                      <% quotationQuotes.forEach(q => { %>
                        <td>
                          <textarea class="customer-comparison-input" name="compare_<%= field.key %>_<%= q.id %>" rows="2" maxlength="1000" placeholder="<%= field.placeholder %>" <%= locked ? 'readonly' : '' %>><%= values[String(q.id)] || '' %></textarea>
                        </td>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (!locked) { %>
              <button class="btn outline" type="submit">Save comparison</button>
            <% } %>
          </form>
        <% } %>
      </div>

      <% if (!locked) { %>
      <form method="post" action="/case/<%= c.id %>/submit" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card" style="padding:14px">
          <p class="small muted" style="margin-top:0"><%= shortDisclaimerCheckout %></p>
          <label style="font-weight:400;display:flex;gap:8px;align-items:flex-start">
            <input type="checkbox" name="agree_terms" value="1" style="width:auto;margin-top:3px" required>
            <span class="small">I have read and agree to the <a href="/terms" target="_blank">Terms of Service</a>,
              <a href="/privacy" target="_blank">Privacy Policy</a> and <a href="/disclaimer" target="_blank">Disclaimer</a>.</span>
          </label>
        </div>
        <button class="btn" type="submit" <%= quotes.length === 0 ? 'disabled' : '' %>>Submit my case</button>
      </form>
      <% } %>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
</body>
</html>
